.detail-image {
  width: 100%;
  height: 420rpx;
  display: block;
  border-radius: 12rpx;
  background: #edf1f7;
}

.title {
  font-size: 38rpx;
  font-weight: 800;
}

.summary {
  margin-top: 18rpx;
  line-height: 1.7;
}

.param-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf1f7;
}

.param-row text:last-child {
  color: #1677ff;
}

.bottom-actions {
  display: flex;
  gap: 18rpx;
  padding-bottom: 24rpx;
}

.bottom-actions button {
  flex: 1;
}
