<view class="page">
  <view class="panel intro">{{copy.intro}}</view>
  <view wx:for="{{cases}}" wx:key="id" class="panel">
    <image class="card-image" src="{{item.imageUrl}}" mode="aspectFill" />
    <view class="title">{{item.name}}</view>
    <view class="muted">{{item.location}} · {{item.industry}}</view>
    <view class="summary">{{item.summary}}</view>
  </view>
</view>
