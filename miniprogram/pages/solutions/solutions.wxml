<view class="page">
  <view class="panel intro">{{copy.intro}}</view>
  <view wx:for="{{solutions}}" wx:key="id" class="panel">
    <image class="card-image" src="{{item.imageUrl}}" mode="aspectFill" />
    <view class="title">{{item.title}}</view>
    <view class="muted">{{item.industry}}</view>
    <view class="summary">{{item.summary}}</view>
    <view class="footer">{{copy.recommended}}</view>
  </view>
</view>
