.quote-page {
  padding-bottom: 138rpx;
}

.quote-hero {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 12rpx;
  color: #ffffff;
  background: #1677ff;
}

.hero-kicker {
  margin-bottom: 12rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 12rpx;
  max-width: 420rpx;
  font-size: 24rpx;
  line-height: 1.5;
  opacity: 0.92;
}

.hero-total {
  min-width: 190rpx;
  padding: 18rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.14);
}

.hero-total text,
.hero-total strong {
  display: block;
}

.hero-total text {
  font-size: 22rpx;
  opacity: 0.85;
}

.hero-total strong {
  margin-top: 14rpx;
  font-size: 32rpx;
}

.compact {
  margin-top: 0;
  font-size: 30rpx;
}

.scenario-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.scenario {
  padding: 18rpx 14rpx;
  border: 1rpx solid #d9e1ee;
  border-radius: 10rpx;
  text-align: center;
  color: #31415c;
  background: #f8fbff;
}

.scenario.active {
  color: #1677ff;
  border-color: #1677ff;
  background: #eef5ff;
  font-weight: 700;
}

.setup-panel {
  margin-bottom: 22rpx;
}

.setup-hint {
  margin-bottom: 18rpx;
  line-height: 1.5;
  font-size: 24rpx;
}

.count-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #d9e1ee;
  border-radius: 10rpx;
  background: #f8fbff;
}

.add-test-btn {
  height: 72rpx;
  line-height: 72rpx;
  margin-top: 16rpx;
  border-radius: 10rpx;
  color: #1677ff;
  font-size: 26rpx;
  font-weight: 700;
  background: #eef5ff;
}

.count-input,
.site-input,
.qty-input {
  width: 118rpx;
  min-height: 64rpx;
  padding: 0 16rpx;
  border: 1rpx solid #d9e1ee;
  border-radius: 8rpx;
  text-align: center;
  background: #ffffff;
  box-sizing: border-box;
}

.floating-title {
  margin-top: 4rpx;
}

.test-card {
  padding: 22rpx;
}

.test-head {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.test-index {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  flex: none;
  border-radius: 14rpx;
  text-align: center;
  color: #ffffff;
  font-weight: 700;
  background: #1677ff;
}

.test-main {
  min-width: 0;
  flex: 1;
}

.test-name {
  width: 100%;
  min-height: 66rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d9e1ee;
  border-radius: 10rpx;
  color: #17233d;
  font-size: 30rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.test-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
  color: #79879c;
  font-size: 24rpx;
}

.category-title {
  margin: 10rpx 0 14rpx;
  color: #31415c;
  font-size: 26rpx;
  font-weight: 700;
}

.category-strip {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  padding-bottom: 10rpx;
}

.category-chip {
  min-width: 160rpx;
  flex: none;
  padding: 14rpx 16rpx;
  border: 1rpx solid #d9e1ee;
  border-radius: 10rpx;
  background: #f8fbff;
}

.category-chip text,
.category-chip strong {
  display: block;
}

.category-chip text {
  color: #17233d;
  font-size: 25rpx;
  font-weight: 700;
}

.category-chip strong {
  margin-top: 6rpx;
  color: #79879c;
  font-size: 21rpx;
  font-weight: 400;
}

.category-chip.active {
  border-color: #1677ff;
  background: #eef5ff;
}

.category-chip.done strong {
  color: #1677ff;
}

.category-chip.skipped {
  border-style: dashed;
  background: #f5f7fa;
}

.category-detail {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf1f7;
}

.category-detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.category-name {
  color: #17233d;
  font-size: 30rpx;
  font-weight: 700;
}

.skip-btn {
  width: 172rpx;
  height: 64rpx;
  line-height: 64rpx;
  flex: none;
  border-radius: 8rpx;
  color: #1677ff;
  font-size: 24rpx;
  background: #eef5ff;
}

.skip-btn.restore {
  color: #ffffff;
  background: #1677ff;
}

.empty-category {
  margin-bottom: 16rpx;
  padding: 18rpx;
  border-radius: 10rpx;
  color: #79879c;
  font-size: 24rpx;
  line-height: 1.5;
  background: #f5f7fa;
}

.library-btn {
  height: 72rpx;
  line-height: 72rpx;
  margin-bottom: 16rpx;
  border-radius: 10rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  background: #1677ff;
}

.selected-title {
  margin: 18rpx 0 14rpx;
  color: #31415c;
  font-size: 25rpx;
  font-weight: 700;
}

.product-card {
  margin-bottom: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #e5eaf3;
  border-radius: 10rpx;
  background: #ffffff;
}

.product-card.selected {
  border-color: #1677ff;
  background: #f8fbff;
}

.product-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.product-head > view {
  min-width: 0;
  flex: 1;
}

.product-thumb {
  width: 112rpx;
  height: 86rpx;
  flex: none;
  border-radius: 8rpx;
  background: #eef3fb;
}

.product-name {
  margin-bottom: 8rpx;
  color: #17233d;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.select-btn {
  width: 116rpx;
  height: 60rpx;
  line-height: 60rpx;
  flex: none;
  border-radius: 999rpx;
  color: #1677ff;
  font-size: 24rpx;
  background: #eef5ff;
}

.select-btn.checked {
  color: #ffffff;
  background: #1677ff;
}

.product-info {
  margin-top: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #edf1f7;
  color: #31415c;
  font-size: 24rpx;
}

.info-row strong {
  color: #1677ff;
}

.quantity-row {
  border-bottom: 0;
}

.qty-input[disabled] {
  color: #b5c0cf;
  background: #f5f7fa;
}

.parameter-block,
.summary-text {
  margin-top: 12rpx;
  padding: 14rpx;
  border-radius: 10rpx;
  background: #f5f7fa;
}

.parameter-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.parameter-list text {
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  color: #31415c;
  font-size: 22rpx;
  background: #ffffff;
}

.summary-text text {
  display: block;
  line-height: 1.55;
  font-size: 24rpx;
}

.summary-text text:last-child {
  margin-top: 8rpx;
  color: #31415c;
}

.product-subtotal {
  margin-top: 14rpx;
  text-align: right;
  color: #1677ff;
  font-weight: 700;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 12rpx 0;
  padding: 18rpx 20rpx;
  border: 1rpx solid #d9e1ee;
  border-radius: 10rpx;
  background: #ffffff;
}

.picker-row text:last-child {
  flex: none;
  color: #1677ff;
}

.discount-row,
.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  color: #31415c;
}

.discount-row strong {
  color: #1677ff;
}

.remark {
  height: 150rpx;
  padding-top: 20rpx;
  line-height: 1.5;
}

.summary-card {
  margin-bottom: 24rpx;
}

.summary-row {
  border-bottom: 1rpx solid #edf1f7;
}

.summary-row:last-child {
  border-bottom: 0;
}

.summary-row strong {
  color: #17233d;
}

.summary-row .amount {
  color: #1677ff;
  font-size: 34rpx;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e5eaf3;
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(23, 35, 61, 0.06);
}

.ghost-action,
.primary-action {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.ghost-action {
  flex: 1;
  color: #1677ff;
  background: #eef5ff;
}

.primary-action {
  flex: 1.4;
  color: #ffffff;
  background: #1677ff;
}

.picker-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
}

.picker-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(23, 35, 61, 0.42);
}

.product-picker {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -12rpx 40rpx rgba(23, 35, 61, 0.16);
}

.picker-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: #d9e1ee;
}

.picker-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.picker-title {
  color: #17233d;
  font-size: 32rpx;
  font-weight: 700;
}

.picker-hint {
  margin-top: 8rpx;
  line-height: 1.45;
  font-size: 23rpx;
}

.picker-close {
  width: 116rpx;
  height: 60rpx;
  line-height: 60rpx;
  flex: none;
  border-radius: 999rpx;
  color: #1677ff;
  font-size: 24rpx;
  background: #eef5ff;
}

.picker-list {
  height: 680rpx;
}

.picker-product {
  display: flex;
  gap: 18rpx;
  margin-bottom: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #e5eaf3;
  border-radius: 12rpx;
  background: #ffffff;
}

.picker-product.selected {
  border-color: #1677ff;
  background: #f8fbff;
}

.picker-product-img {
  width: 164rpx;
  height: 124rpx;
  flex: none;
  border-radius: 10rpx;
  background: #eef3fb;
}

.picker-product-main {
  min-width: 0;
  flex: 1;
}

.picker-product-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.picker-check {
  min-width: 84rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  text-align: center;
  color: #1677ff;
  font-size: 22rpx;
  background: #eef5ff;
}

.picker-product.selected .picker-check {
  color: #ffffff;
  background: #1677ff;
}

.picker-summary {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: #31415c;
  font-size: 24rpx;
  line-height: 1.45;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.picker-price {
  margin-top: 12rpx;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 700;
}

.picker-done {
  height: 78rpx;
  line-height: 78rpx;
  margin-top: 12rpx;
  border-radius: 10rpx;
  color: #ffffff;
  font-size: 28rpx;
  background: #1677ff;
}
