.ai-page {
  min-height: 100vh;
  padding: 20rpx 20rpx 28rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #eef3f9;
}

.assistant-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #dce7f5;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(22, 119, 255, 0.08);
}

.bot-avatar,
.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  color: #ffffff;
  font-weight: 700;
  background: #1677ff;
}

.bot-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  font-size: 34rpx;
}

.bot-main {
  min-width: 0;
  flex: 1;
}

.bot-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.bot-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #17233d;
}

.bot-badge {
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #1677ff;
  background: #eef5ff;
}

.bot-role {
  margin-top: 6rpx;
  color: #79879c;
  font-size: 24rpx;
}

.chat-window {
  flex: 1;
  min-height: 0;
  padding: 20rpx 8rpx;
  border: 1rpx solid #dce7f5;
  border-radius: 12rpx;
  background: #f8fbff;
  box-sizing: border-box;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.message-row.user {
  justify-content: flex-end;
}

.small {
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.user-avatar {
  background: #31415c;
}

.bubble-wrap {
  max-width: 78%;
}

.message-row.user .bubble-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.speaker {
  margin-bottom: 6rpx;
  color: #79879c;
  font-size: 22rpx;
}

.bubble {
  padding: 18rpx 20rpx;
  border-radius: 6rpx 18rpx 18rpx 18rpx;
  color: #17233d;
  font-size: 28rpx;
  line-height: 1.65;
  background: #ffffff;
  border: 1rpx solid #e5eaf3;
  word-break: break-all;
}

.message-row.user .bubble {
  color: #ffffff;
  border-color: #1677ff;
  border-radius: 18rpx 6rpx 18rpx 18rpx;
  background: #1677ff;
}

.typing {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 40rpx;
}

.typing text {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #9fb4cf;
}

.quick-panel {
  display: flex;
  gap: 12rpx;
  margin: 16rpx 0;
  overflow-x: auto;
  white-space: nowrap;
}

.quick-chip {
  flex: none;
  max-width: 420rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid #d5e4f6;
  border-radius: 999rpx;
  color: #1677ff;
  font-size: 24rpx;
  background: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
}

.composer {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx;
  border: 1rpx solid #dce7f5;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(23, 35, 61, 0.06);
}

.composer .chat-input {
  flex: 1;
  height: 76rpx;
  min-height: 76rpx;
  margin: 0;
  border-radius: 38rpx;
  background: #f5f7fa;
}

.send-btn {
  width: 132rpx;
  height: 76rpx;
  line-height: 76rpx;
  flex: none;
  border-radius: 38rpx;
  color: #ffffff;
  font-size: 26rpx;
  background: #1677ff;
}

.send-btn[disabled] {
  color: rgba(255, 255, 255, 0.85);
  background: #91c4ff;
}
