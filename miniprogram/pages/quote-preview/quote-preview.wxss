.preview-page {
  padding-bottom: 142rpx;
}

.preview-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 12rpx;
  color: #ffffff;
  background: #1677ff;
}

.hero-main {
  min-width: 0;
  flex: 1;
}

.hero-kicker {
  margin-bottom: 12rpx;
  font-size: 22rpx;
  opacity: 0.86;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 12rpx;
  max-width: 520rpx;
  font-size: 24rpx;
  line-height: 1.5;
  opacity: 0.92;
}

.status-pill {
  flex: none;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 700;
  background: #ffffff;
}

.status-pill.sent {
  color: #16835b;
}

.compact {
  margin-top: 0;
  font-size: 30rpx;
}

.empty-state {
  margin-top: 160rpx;
  text-align: center;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
}

.empty-desc {
  margin: 18rpx 0 28rpx;
  line-height: 1.5;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.info-grid view {
  min-width: 0;
  padding: 18rpx;
  border-radius: 10rpx;
  background: #f8fbff;
}

.info-grid text,
.info-grid strong {
  display: block;
}

.info-grid text {
  margin-bottom: 8rpx;
  font-size: 22rpx;
}

.info-grid strong {
  overflow-wrap: anywhere;
  color: #17233d;
  font-size: 26rpx;
}

.detail-row,
.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf1f7;
  color: #31415c;
}

.detail-row text,
.total-row text {
  flex: none;
  color: #79879c;
}

.detail-row strong,
.total-row strong {
  min-width: 0;
  text-align: right;
  overflow-wrap: anywhere;
  color: #17233d;
}

.word-hint {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.word-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.file-chip,
.word-badge {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.file-chip {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #31415c;
  background: #f5f7fa;
}

.word-badge {
  flex: none;
  color: #1677ff;
  font-weight: 700;
  background: #eef5ff;
}

.word-page {
  padding: 28rpx 24rpx;
  border: 1rpx solid #d9e1ee;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(23, 35, 61, 0.06);
}

.doc-title {
  text-align: center;
  color: #17233d;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.doc-subtitle {
  margin-top: 10rpx;
  text-align: center;
  color: #52627a;
  font-size: 24rpx;
}

.doc-meta {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.doc-meta view {
  padding: 12rpx;
  border: 1rpx solid #edf1f7;
}

.doc-meta text,
.doc-meta strong {
  display: block;
}

.doc-meta text {
  color: #79879c;
  font-size: 21rpx;
}

.doc-meta strong {
  margin-top: 6rpx;
  color: #17233d;
  font-size: 23rpx;
  overflow-wrap: anywhere;
}

.doc-section-title {
  margin-top: 24rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx solid #1677ff;
  color: #17233d;
  font-size: 26rpx;
  font-weight: 700;
}

.doc-paragraph {
  margin-top: 12rpx;
  color: #31415c;
  font-size: 24rpx;
  line-height: 1.65;
}

.doc-table {
  margin-top: 14rpx;
  border: 1rpx solid #d9e1ee;
}

.doc-table-head,
.doc-table-row {
  display: grid;
  grid-template-columns: 1.25fr 1.35fr 0.6fr 0.8fr;
}

.doc-table-head {
  color: #17233d;
  font-weight: 700;
  background: #eef5ff;
}

.doc-table-head text,
.doc-table-row text {
  min-width: 0;
  padding: 10rpx 8rpx;
  border-right: 1rpx solid #d9e1ee;
  border-bottom: 1rpx solid #d9e1ee;
  font-size: 20rpx;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.doc-table-head text:last-child,
.doc-table-row text:last-child {
  border-right: 0;
}

.doc-table-row:last-child text {
  border-bottom: 0;
}

.doc-total-line {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #f8fbff;
}

.doc-total-line text,
.doc-total-line strong {
  color: #31415c;
  font-size: 24rpx;
}

.doc-total-line strong {
  color: #1677ff;
  font-size: 28rpx;
}

.doc-footer {
  margin-top: 22rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #d9e1ee;
  color: #79879c;
  font-size: 21rpx;
  line-height: 1.5;
}

.remark-box {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 10rpx;
  line-height: 1.55;
  background: #f5f7fa;
}

.remark-box text,
.remark-box view {
  display: block;
}

.remark-box view {
  margin-top: 8rpx;
  color: #31415c;
}

.floating-title {
  margin-top: 4rpx;
}

.test-preview {
  padding: 22rpx;
}

.test-head {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.test-index {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  flex: none;
  border-radius: 14rpx;
  text-align: center;
  color: #ffffff;
  font-weight: 700;
  background: #1677ff;
}

.test-main {
  min-width: 0;
  flex: 1;
}

.test-name {
  margin-bottom: 8rpx;
  color: #17233d;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.35;
}

.category-preview {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf1f7;
}

.category-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.category-name {
  color: #31415c;
  font-size: 28rpx;
  font-weight: 700;
}

.category-count {
  flex: none;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #1677ff;
  font-size: 22rpx;
  background: #eef5ff;
}

.product-preview {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #e5eaf3;
  border-radius: 10rpx;
  background: #f8fbff;
}

.product-img {
  width: 142rpx;
  height: 110rpx;
  flex: none;
  border-radius: 8rpx;
  background: #eef3fb;
}

.product-body {
  min-width: 0;
  flex: 1;
}

.product-name {
  margin-bottom: 8rpx;
  color: #17233d;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.product-summary {
  margin-top: 10rpx;
  color: #31415c;
  font-size: 24rpx;
  line-height: 1.5;
}

.product-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.product-meta text,
.product-meta strong {
  padding: 7rpx 10rpx;
  border-radius: 999rpx;
  color: #31415c;
  font-size: 22rpx;
  background: #ffffff;
}

.product-meta strong {
  color: #1677ff;
}

.parameter-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.parameter-list text {
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  color: #31415c;
  font-size: 22rpx;
  background: #ffffff;
}

.total-panel {
  margin-bottom: 24rpx;
}

.total-row.final {
  border-bottom: 0;
}

.total-row.final strong {
  color: #1677ff;
  font-size: 36rpx;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  gap: 12rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e5eaf3;
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(23, 35, 61, 0.06);
}

.ghost-action,
.primary-action {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.ghost-action {
  flex: 1;
  color: #1677ff;
  background: #eef5ff;
}

.primary-action {
  flex: 1.15;
  color: #ffffff;
  background: #1677ff;
}
